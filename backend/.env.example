# ─── Contoh konfigurasi environment (SDD §9.2) ───────────────────────────────
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit file `.env` yang berisi kredensial asli.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kendis_market?schema=public"

# ── Autentikasi ──────────────────────────────────────────────────────────────
# jwt   : access token (Authorization: Bearer) + refresh token (cookie httpOnly)
# session: ID sesi acak opaque di tabel Session (cookie `sid`)
AUTH_STRATEGY=jwt

# Wajib jika AUTH_STRATEGY=jwt. Minimal 16 karakter.
JWT_ACCESS_SECRET=ubah-secret-access-token-minimal-16-karakter
JWT_REFRESH_SECRET=ubah-secret-refresh-token-minimal-16-karakter
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Keamanan ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Rate limiting (SDD §6.6) ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Logging (SDD §9.2) ───────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
# Default: debug di development, info di production
LOG_LEVEL=debug

# ── CORS ─────────────────────────────────────────────────────────────────────
# Daftar origin dipisah koma.
ALLOWED_ORIGINS=http://localhost:5173

# ── Upload gambar ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5

# ── Cloudflare R2 (opsional di development, wajib di production) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
