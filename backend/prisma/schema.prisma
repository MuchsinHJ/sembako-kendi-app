generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUM
// ─────────────────────────────────────────

enum ProductStatus {
  AKTIF
  NONAKTIF
}

enum PaymentStatus {
  LUNAS
  UTANG
}

enum TransactionStatus {
  AKTIF
  DIBATALKAN
}

// Sumber barang: milik toko sendiri atau titipan penitip (konsinyasi).
// BR-A: TITIPAN wajib punya consignorId; MILIK_SENDIRI wajib null.
enum ProductType {
  MILIK_SENDIRI
  TITIPAN
}

enum ConsignorStatus {
  AKTIF
  NONAKTIF
}

// Arah pergerakan stok titipan. `jumlah` selalu positif (CHECK constraint),
// arah ditentukan oleh `tipe`.
enum ConsignmentMovementType {
  TERIMA
  RETUR
}

// ─────────────────────────────────────────
// MODEL
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  nama         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions  Transaction[]
  payments      PaymentHistory[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  stockAdjustments StockAdjustment[]
  consignmentMovements ConsignmentMovement[]
  consignorPayments ConsignorPayment[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

// Tabel opsional — dipakai hanya jika AUTH_STRATEGY=session
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String        @id @default(uuid())
  nama        String
  kategori    String
  // Untuk produk TITIPAN, hargaModal = harga setor per unit ke penitip (BR-B).
  hargaJual   Decimal       @db.Decimal(12, 2)
  hargaModal  Decimal       @db.Decimal(12, 2)
  stok        Int           @default(0)
  stokMinimum Int           @default(0)
  status      ProductStatus @default(AKTIF)
  // BR-A: tipe & consignorId immutable setelah produk dibuat.
  tipe        ProductType   @default(MILIK_SENDIRI)
  consignorId String?
  consignor   Consignor?    @relation(fields: [consignorId], references: [id])
  fotoKey     String? // object key di Cloudflare R2, mis. "products/{id}/{uuid}.webp"
  fotoUrl     String? // URL publik hasil upload, dikirim ke frontend
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  detailTransaksi DetailTransaction[]
  stockAdjustments StockAdjustment[]
  consignmentMovements ConsignmentMovement[]

  @@index([status])
  @@index([kategori])
  @@index([tipe])
  @@index([consignorId])
}

// ─────────────────────────────────────────
// KONSINYASI (barang titipan)
// ─────────────────────────────────────────

model Consignor {
  id        String          @id @default(uuid())
  nama      String
  noHp      String?
  catatan   String?
  status    ConsignorStatus @default(AKTIF)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  products  Product[]
  movements ConsignmentMovement[]
  payments  ConsignorPayment[]

  @@index([status])
}

// Append-only. Menambah/mengurangi stok titipan beserta jejak stok sebelum/sesudah.
model ConsignmentMovement {
  id            String                  @id @default(uuid())
  consignorId   String
  consignor     Consignor               @relation(fields: [consignorId], references: [id])
  productId     String
  product       Product                 @relation(fields: [productId], references: [id])
  tipe          ConsignmentMovementType
  jumlah        Int // selalu positif; arah ditentukan oleh `tipe`
  stokSebelum   Int
  stokSesudah   Int
  catatan       String?
  dicatatOlehId String
  dicatatOleh   User                    @relation(fields: [dicatatOlehId], references: [id])
  createdAt     DateTime                @default(now())

  @@index([consignorId])
  @@index([productId])
  @@index([createdAt])
}

/**
 * Setoran ke penitip (Tahap 2). Append-only: tidak ada endpoint edit/hapus.
 *
 * BR-D: `jumlahBayar > 0` (CHECK di database) dan tidak boleh melebihi saldo
 * kewajiban saat dicatat. `saldoSetelahBayar` adalah snapshot audit; boleh
 * negatif bila transaksi terkait di-void setelah setoran (BR-F).
 */
model ConsignorPayment {
  id                String    @id @default(uuid())
  consignorId       String
  consignor         Consignor @relation(fields: [consignorId], references: [id])
  tanggalBayar      DateTime  @default(now())
  jumlahBayar       Decimal   @db.Decimal(12, 2)
  saldoSetelahBayar Decimal   @db.Decimal(12, 2)
  catatan           String?
  dicatatOlehId     String
  dicatatOleh       User      @relation(fields: [dicatatOlehId], references: [id])
  createdAt         DateTime  @default(now())

  @@index([consignorId])
}

model Transaction {
  id               String            @id @default(uuid())
  tanggal          DateTime          @default(now())
  total            Decimal           @db.Decimal(12, 2)
  // Uang tunai yang diserahkan pembeli. Status pembayaran diturunkan dari nilai ini:
  // uangDiterima >= total -> LUNAS (kembalian = uangDiterima - total)
  // uangDiterima <  total -> UTANG (sisaSaldoUtang = total - uangDiterima)
  uangDiterima     Decimal?          @db.Decimal(12, 2)
  kembalian        Decimal?          @db.Decimal(12, 2)
  statusPembayaran PaymentStatus
  statusTransaksi  TransactionStatus @default(AKTIF)
  namaPembeli      String?
  noHpPembeli      String?
  sisaSaldoUtang   Decimal?          @db.Decimal(12, 2)
  dibuatOlehId     String
  dibuatOleh       User              @relation(fields: [dibuatOlehId], references: [id])
  dibatalkanPada   DateTime?
  createdAt        DateTime          @default(now())

  items    DetailTransaction[]
  payments PaymentHistory[]

  @@index([statusTransaksi])
  @@index([statusPembayaran])
  @@index([tanggal])
}

model DetailTransaction {
  id                 String      @id @default(uuid())
  transactionId      String
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  namaProdukSnapshot String
  hargaJualSnapshot  Decimal     @db.Decimal(12, 2)
  hargaModalSnapshot Decimal     @db.Decimal(12, 2)
  jumlah             Int
  subtotal           Decimal     @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId])
}

model PaymentHistory {
  id                String      @id @default(uuid())
  transactionId     String
  transaction       Transaction @relation(fields: [transactionId], references: [id])
  tanggalBayar      DateTime    @default(now())
  jumlahBayar       Decimal     @db.Decimal(12, 2)
  saldoSetelahBayar Decimal     @db.Decimal(12, 2)
  dicatatOlehId     String
  dicatatOleh       User        @relation(fields: [dicatatOlehId], references: [id])

  @@index([transactionId])
}

model StockAdjustment {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  delta         Int
  alasan        String
  stokSebelum   Int
  stokSesudah   Int
  dicatatOlehId String
  dicatatOleh   User     @relation(fields: [dicatatOlehId], references: [id])
  createdAt     DateTime @default(now())

  @@index([productId])
}
